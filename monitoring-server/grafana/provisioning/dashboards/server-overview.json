{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Overview",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 85 },
              { "color": "red", "value": 95 }
            ]
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "title": "CPU Usage",
      "type": "gauge",
      "targets": [
        {
          "expr": "(1 - avg by(server)(rate(node_cpu_seconds_total{mode=\"idle\", server=~\"$server\"}[5m]))) * 100",
          "legendFormat": "{{ server }}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 85 },
              { "color": "red", "value": 95 }
            ]
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "title": "Memory Usage",
      "type": "gauge",
      "targets": [
        {
          "expr": "(1 - (node_memory_MemAvailable_bytes{server=~\"$server\"} / node_memory_MemTotal_bytes{server=~\"$server\"})) * 100",
          "legendFormat": "{{ server }}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 80 },
              { "color": "red", "value": 90 }
            ]
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "title": "Disk Usage (/)",
      "type": "gauge",
      "targets": [
        {
          "expr": "(1 - (node_filesystem_avail_bytes{mountpoint=\"/\", server=~\"$server\"} / node_filesystem_size_bytes{mountpoint=\"/\", server=~\"$server\"})) * 100",
          "legendFormat": "{{ server }}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 3600 }
            ]
          }
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none"
      },
      "title": "Uptime",
      "type": "stat",
      "targets": [
        {
          "expr": "time() - node_boot_time_seconds{server=~\"$server\"}",
          "legendFormat": "{{ server }}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "id": 101,
      "title": "CPU & Load",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "fillOpacity": 15, "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 5,
      "options": { "tooltip": { "mode": "multi" } },
      "title": "CPU Usage Over Time",
      "type": "timeseries",
      "targets": [
        {
          "expr": "(1 - avg by(server)(rate(node_cpu_seconds_total{mode=\"idle\", server=~\"$server\"}[5m]))) * 100",
          "legendFormat": "{{ server }}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 10, "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 6,
      "options": { "tooltip": { "mode": "multi" } },
      "title": "System Load (15m avg)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "node_load15{server=~\"$server\"}",
          "legendFormat": "{{ server }}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "id": 102,
      "title": "Memory",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "fillOpacity": 20, "lineWidth": 2, "stacking": { "mode": "normal" } }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "id": 7,
      "options": { "tooltip": { "mode": "multi" } },
      "title": "Memory Breakdown",
      "type": "timeseries",
      "targets": [
        {
          "expr": "node_memory_MemTotal_bytes{server=~\"$server\"} - node_memory_MemAvailable_bytes{server=~\"$server\"}",
          "legendFormat": "{{ server }} — Used"
        },
        {
          "expr": "node_memory_MemAvailable_bytes{server=~\"$server\"}",
          "legendFormat": "{{ server }} — Available"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "fillOpacity": 15, "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "id": 8,
      "options": { "tooltip": { "mode": "multi" } },
      "title": "Memory Usage %",
      "type": "timeseries",
      "targets": [
        {
          "expr": "(1 - (node_memory_MemAvailable_bytes{server=~\"$server\"} / node_memory_MemTotal_bytes{server=~\"$server\"})) * 100",
          "legendFormat": "{{ server }}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 },
      "id": 103,
      "title": "Disk",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "fillOpacity": 15, "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "id": 9,
      "options": { "tooltip": { "mode": "multi" } },
      "title": "Disk Usage %",
      "type": "timeseries",
      "targets": [
        {
          "expr": "(1 - (node_filesystem_avail_bytes{fstype!~\"tmpfs|devtmpfs\", server=~\"$server\"} / node_filesystem_size_bytes{server=~\"$server\"})) * 100",
          "legendFormat": "{{ server }} — {{ mountpoint }}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "fillOpacity": 10, "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "id": 10,
      "options": { "tooltip": { "mode": "multi" } },
      "title": "Disk I/O (read/write bytes)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(node_disk_read_bytes_total{server=~\"$server\"}[5m])",
          "legendFormat": "{{ server }} read — {{ device }}"
        },
        {
          "expr": "rate(node_disk_written_bytes_total{server=~\"$server\"}[5m])",
          "legendFormat": "{{ server }} write — {{ device }}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 },
      "id": 104,
      "title": "Network",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "fillOpacity": 10, "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 35 },
      "id": 11,
      "options": { "tooltip": { "mode": "multi" } },
      "title": "Network Traffic (receive / transmit)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(node_network_receive_bytes_total{device!~\"lo|docker.*\", server=~\"$server\"}[5m])",
          "legendFormat": "{{ server }} RX — {{ device }}"
        },
        {
          "expr": "-rate(node_network_transmit_bytes_total{device!~\"lo|docker.*\", server=~\"$server\"}[5m])",
          "legendFormat": "{{ server }} TX — {{ device }}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 10, "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 35 },
      "id": 12,
      "options": { "tooltip": { "mode": "multi" } },
      "title": "Network Errors",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(node_network_receive_errs_total{server=~\"$server\"}[5m])",
          "legendFormat": "{{ server }} RX errors — {{ device }}"
        },
        {
          "expr": "rate(node_network_transmit_errs_total{server=~\"$server\"}[5m])",
          "legendFormat": "{{ server }} TX errors — {{ device }}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 43 },
      "id": 106,
      "title": "Application Metrics",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 10, "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 44 },
      "id": 15,
      "options": { "tooltip": { "mode": "multi" } },
      "title": "Comparison Queue Size",
      "type": "timeseries",
      "targets": [
        {
          "expr": "comparison_queue_size{server=~\"$server\"}",
          "legendFormat": "{{ server }}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 10, "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 44 },
      "id": 16,
      "options": { "tooltip": { "mode": "multi" } },
      "title": "Comparison Active Workers",
      "type": "timeseries",
      "targets": [
        {
          "expr": "comparison_active_workers{server=~\"$server\"}",
          "legendFormat": "{{ server }}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "fillOpacity": 10, "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 44 },
      "id": 17,
      "options": { "tooltip": { "mode": "multi" } },
      "title": "HTTP Request Rate (app /metrics)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (server, method, path) (rate(http_request_duration_seconds_count{server=~\"$server\"}[5m]))",
          "legendFormat": "{{ server }} {{ method }} {{ path }}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "fillOpacity": 10, "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 52 },
      "id": 18,
      "options": { "tooltip": { "mode": "multi" } },
      "title": "HTTP Latency p50 / p95",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (server, le) (rate(http_request_duration_seconds_bucket{server=~\"$server\"}[5m])))",
          "legendFormat": "{{ server }} p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (server, le) (rate(http_request_duration_seconds_bucket{server=~\"$server\"}[5m])))",
          "legendFormat": "{{ server }} p95"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "fillOpacity": 10, "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 52 },
      "id": 19,
      "options": { "tooltip": { "mode": "multi" } },
      "title": "HTTP Error Rate (4xx / 5xx)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (server) (rate(http_request_duration_seconds_count{server=~\"$server\", status_code=~\"4..\"}[5m]))",
          "legendFormat": "{{ server }} 4xx"
        },
        {
          "expr": "sum by (server) (rate(http_request_duration_seconds_count{server=~\"$server\", status_code=~\"5..\"}[5m]))",
          "legendFormat": "{{ server }} 5xx"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "fillOpacity": 10, "lineWidth": 2, "stacking": { "mode": "normal" } }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 60 },
      "id": 20,
      "options": { "tooltip": { "mode": "multi" } },
      "title": "Receiver Request Rate by Integration",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (integration) (rate(http_request_duration_seconds_count{server=\"receiver\", integration=~\".+\"}[5m]))",
          "legendFormat": "{{ integration }}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "fillOpacity": 10, "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 60 },
      "id": 21,
      "options": { "tooltip": { "mode": "multi" } },
      "title": "Node.js Memory (heap / RSS)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "nodejs_heap_size_used_bytes{server=~\"$server\"}",
          "legendFormat": "{{ server }} heap used"
        },
        {
          "expr": "process_resident_memory_bytes{server=~\"$server\"}",
          "legendFormat": "{{ server }} RSS"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 68 },
      "id": 105,
      "title": "HTTP Probes (Blackbox)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "red", "text": "DOWN" }, "1": { "color": "green", "text": "UP" } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 69 },
      "id": 13,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "title": "Endpoint Status",
      "type": "stat",
      "targets": [
        {
          "expr": "probe_success",
          "legendFormat": "{{ instance }}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 2 }
            ]
          },
          "custom": { "fillOpacity": 10, "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 69 },
      "id": 14,
      "options": { "tooltip": { "mode": "multi" } },
      "title": "HTTP Response Time",
      "type": "timeseries",
      "targets": [
        {
          "expr": "probe_duration_seconds",
          "legendFormat": "{{ instance }}"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["monitoring", "servers", "node-exporter"],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(node_uname_info, server)",
        "includeAll": true,
        "multi": true,
        "name": "server",
        "query": "label_values(node_uname_info, server)",
        "refresh": 2,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "title": "Server Overview",
  "uid": "server-overview"
}
