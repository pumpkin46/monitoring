      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 8 },
      "id": 2,
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "title": "System Logs (syslog)",
      "type": "logs",
