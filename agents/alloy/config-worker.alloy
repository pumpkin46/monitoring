// ── Worker (background jobs) — Node.js Express ────────────────────
// App: PM2 process name "worker", port 8001 (see worker/app.js)
//
// Host metrics: base config.alloy (prometheus.exporter.unix → remote_write).
// App metrics: GET /metrics on port 8001 (express-prom-bundle in worker/app.js).
//
// HTTP uptime: add a Blackbox probe for http://WORKER_IP:8001/ in prometheus.yml.

prometheus.scrape "worker_metrics" {
  targets = [{
    __address__ = "localhost:8001",
  }]
  metrics_path    = "/metrics"
  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.add_labels.receiver]
}

// PM2 application logs (adjust user path if PM2 does not run as root)
local.file_match "worker_pm2_logs" {
  path_targets = [
    {
      __path__ = "/root/.pm2/logs/worker-out.log",
      job      = "worker",
      host     = "SERVER_NAME",
      stream   = "stdout",
    },
    {
      __path__ = "/root/.pm2/logs/worker-error.log",
      job      = "worker",
      host     = "SERVER_NAME",
      stream   = "stderr",
    },
  ]
}

loki.source.file "worker_pm2_logs" {
  targets    = local.file_match.worker_pm2_logs.targets
  forward_to = [loki.process.worker_logs.receiver]
}

// PM2: "2026-05-22 10:30:00: Listening on port 8001"
// Morgan dev: "GET /path 200 12.345 ms - 42"
// Optional logfmt files: level=info request_id=...
loki.process "worker_logs" {
  stage.regex {
    expression = "^(?P<timestamp>\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}):\\s*(?P<message>.*)$"
  }

  stage.logfmt {
    mapping = {
      level      = "",
      request_id = "",
    }
  }

  stage.labels {
    values = {
      level      = "level",
      request_id = "request_id",
    }
  }

  stage.drop {
    source     = "level"
    expression = "(?i)debug"
  }

  forward_to = [loki.write.monitoring.receiver]
}
