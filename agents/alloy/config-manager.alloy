// ── Manager (control plane) — Node.js Express + Socket.io ─────────
// App: PM2 process name "manager", port 9000 (see manager/app.js)
//
// Host metrics: base config.alloy (prometheus.exporter.unix → remote_write).
// App metrics: GET /metrics on port 9000 (express-prom-bundle in manager/app.js).
//
// HTTP uptime: add a Blackbox probe for http://MANAGER_IP:9000/ in prometheus.yml.

prometheus.scrape "manager_metrics" {
  targets = [{
    __address__ = "localhost:9000",
  }]
  metrics_path    = "/metrics"
  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.add_labels.receiver]
}

// PM2 application logs (adjust user path if PM2 does not run as root)
local.file_match "manager_pm2_logs" {
  path_targets = [
    {
      __path__ = "/root/.pm2/logs/manager-out.log",
      job      = "manager",
      host     = "SERVER_NAME",
      stream   = "stdout",
    },
    {
      __path__ = "/root/.pm2/logs/manager-error.log",
      job      = "manager",
      host     = "SERVER_NAME",
      stream   = "stderr",
    },
  ]
}

loki.source.file "manager_pm2_logs" {
  targets    = local.file_match.manager_pm2_logs.targets
  forward_to = [loki.process.manager_logs.receiver]
}

// PM2: "2026-05-22 10:30:00: listening on *:9000"
// Optional logfmt files: level=info request_id=...
loki.process "manager_logs" {
  stage.regex {
    expression = "^(?P<timestamp>\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}):\\s*(?P<message>.*)$"
  }

  // Morgan access log: derive level from HTTP status (5xx=error, 4xx=warn, else info)
  stage.match {
    selector = "|~ \"\\\\b(?:GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS) \\\\S+ 5\\\\d{2}\\\\b\""
    stage.template {
      source   = "level"
      template = "error"
    }
  }

  stage.match {
    selector = "|~ \"\\\\b(?:GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS) \\\\S+ 4\\\\d{2}\\\\b\""
    stage.template {
      source   = "level"
      template = "warn"
    }
  }

  stage.match {
    selector = "|~ \"\\\\b(?:GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS) \\\\S+ [123]\\\\d{2}\\\\b\""
    stage.template {
      source   = "level"
      template = "info"
    }
  }

  stage.logfmt {
    mapping = {
      level      = "",
      request_id = "",
    }
  }

  stage.labels {
    values = {
      level      = "level",
      request_id = "request_id",
    }
  }

  stage.drop {
    source     = "level"
    expression = "(?i)debug"
  }

  forward_to = [loki.write.monitoring.receiver]
}
